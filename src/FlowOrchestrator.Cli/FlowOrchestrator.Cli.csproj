<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The `flow-orchestrator` .NET tool. Multi-targeted like the libraries: the SDK packs one
    tools/<tfm>/any folder per target framework and `dotnet tool install` picks the newest one the
    machine's runtime can run, so a .NET 10-only machine and a .NET 11 machine both get a native build.
    RollForward=Major lets the net11.0 build run on a later major runtime (e.g. .NET 12) too.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(FlowOrchestratorTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>flow-orchestrator</ToolCommandName>
    <RollForward>Major</RollForward>
    <PackageId>FlowOrchestrator.Cli</PackageId>
    <Description>The flow-orchestrator command-line tool. `flow-orchestrator storage copy` copies a FlowOrchestrator database between SQL Server and PostgreSQL (run history included), with preflight checks, a dry run and checksum verification.</Description>
    <PackageTags>flow;orchestration;workflow;cli;tool;storage;migration;sqlserver;postgresql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowOrchestrator.StorageMigration\FlowOrchestrator.StorageMigration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FlowOrchestrator.StorageMigration.UnitTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.StorageMigration.IntegrationTests" />
  </ItemGroup>

</Project>
