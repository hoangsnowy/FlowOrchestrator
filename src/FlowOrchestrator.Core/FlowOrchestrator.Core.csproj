<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(FlowOrchestratorTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>FlowOrchestrator.Core</PackageId>
    <Description>Core abstractions, execution engine, and in-memory storage for FlowOrchestrator.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- Observability: OpenTelemetry.Api is the API-only ~30 KB package that defines
         TracerProviderBuilder / MeterProviderBuilder. The Activity / Meter primitives
         themselves come from System.Diagnostics in the BCL. The full OpenTelemetry SDK
         is opt-in (the user adds it when they call .AddOpenTelemetry()), so library
         consumers who do not enable telemetry pay essentially nothing at runtime. -->
    <PackageReference Include="OpenTelemetry.Api" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Expose internals to the benchmark harness and the test suites only. The engine, planner,
      step executor and hosted services are internal since 2.0; tests and benchmarks drive them
      directly. Never add another src package here: packages can be mixed at different 2.x
      versions, so an internal must never become a cross-package contract.
    -->
    <InternalsVisibleTo Include="FlowOrchestrator.Benchmarks" />
    <InternalsVisibleTo Include="FlowOrchestrator.Core.UnitTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.Hangfire.UnitTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.InMemory.UnitTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.ServiceBus.UnitTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.Hangfire.IntegrationTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.InMemory.IntegrationTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.PostgreSQL.IntegrationTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.ServiceBus.IntegrationTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.SqlServer.IntegrationTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.Testing.IntegrationTests" />
    <InternalsVisibleTo Include="FlowOrchestrator.RegressionTests" />
    <!-- NSubstitute (Castle DynamicProxy) emits its proxies of internal interfaces such as IStepExecutor here. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
