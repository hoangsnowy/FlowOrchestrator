<Project>
  <PropertyGroup>
    <Authors>FlowOrchestrator Contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/hoangsnowy/FlowOrchestrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hoangsnowy/FlowOrchestrator</PackageProjectUrl>
    <VersionPrefix>2.0.1</VersionPrefix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Supported runtimes: .NET 10 (LTS) and .NET 11 (STS). global.json pins the SDK to 11.0.x,
         the only SDK that can build net11.0. -->
    <FlowOrchestratorTargetFrameworks>net10.0;net11.0</FlowOrchestratorTargetFrameworks>
    <FlowOrchestratorSampleTargetFramework>net11.0</FlowOrchestratorSampleTargetFramework>

    <DefaultItemExcludes>$(DefaultItemExcludes);**/artifacts/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- ── Enterprise warning policy ─────────────────────────────────────────────
       1. TreatWarningsAsErrors      → every warning fails the build, no exceptions.
       2. EnforceCodeStyleInBuild    → .editorconfig severities run at build time
                                       (not just IDE), so style/analyzer rules ship CI errors.
       3. GenerateDocumentationFile  → enables CS1574/CS1580/CS1581/CS1584 (broken cref) and
                                       CS1570/CS1587 (malformed XML doc). Without this flag the
                                       compiler skips XML doc validation entirely.
       4. CS1591 (missing XML doc on public member) is INTENTIONALLY noWarn'd here — CLAUDE.md
          requires doc on new files only; backfilling is opt-in per project. Promote to error
          on a per-project basis once its docs are 100% covered.
       NU1903/NU1902 are NuGet audit warnings handled by the dedicated audit pipeline; they
       must not break local builds because they fire on transitive dependencies we cannot fix
       without an upstream release.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;NU1903;NU1902</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- ── Packaging & supply chain ─────────────────────────────────────────────
       Symbols: a .snupkg beside every .nupkg (pushed to the nuget.org symbol server).
       SourceLink: built into the .NET SDK; PublishRepositoryUrl + EmbedUntrackedSources make the
       PDBs point at the exact GitHub commit. ContinuousIntegrationBuild normalises paths on CI so
       the build is reproducible (Deterministic is the SDK default). Package validation checks every
       package's TFM assets against each other; from 2.0.x on, PackageValidationBaselineVersion pins
       the shipped 2.0.0 API so a minor can no longer break callers. GenerateSBOM embeds an SPDX 2.2
       SBOM (Microsoft.Sbom.Targets) in each package under _manifest/. Properties are harmless on the
       non-packable projects; they only act during `dotnet pack`. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>2.0.0</PackageValidationBaselineVersion>
    <GenerateSBOM>true</GenerateSBOM>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" />
  </ItemGroup>

  <!-- Public API tracking (RS0016/RS0017 are errors under TreatWarningsAsErrors): every public or protected
       member of a package must be listed in its PublicAPI.Unshipped.txt (new since the last release) or
       PublicAPI.Shipped.txt (in a released version). Adding API means adding a line; removing or changing a
       shipped line is a breaking change and needs a major. At each release the Unshipped lines move to
       Shipped in the release commit. -->
  <!-- RS0026/RS0027 (overloads with optional parameters) are API-design advice, not tracking. The existing
       overload pairs (GetRunsPageAsync, TryRegisterAsync, AddFlowDashboard, ToMermaid…) are deliberate:
       the short form is the original contract and the long form adds parameters with a default
       implementation. Tracking (RS0016 new API, RS0017 removed API) stays on as an error. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Link the root xunit.runner.json into every UNIT test project's output so xunit picks up
       parallelizeAssembly: true. Integration projects are excluded because Testcontainers /
       WebApplicationFactory don't tolerate multiple TFM assemblies of the same project starting
       containers in parallel (causes Postgres/SqlServer resource races, observed empirically).
       RegressionTests has its own local xunit.runner.json (parallelism disabled). -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('UnitTests'))">
    <None Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- xunit v3 test projects (*UnitTests / *IntegrationTests / RegressionTests / SampleApp.Tests).
       xUnit1051 asks every call that accepts a CancellationToken to pass
       TestContext.Current.CancellationToken. It fires on ~1,500 existing call sites; threading the
       test token through changes behaviour (calls start aborting on test timeout / run cancel), so
       it is adopted deliberately per suite, not as part of the xunit v2 -> v3 migration. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
</Project>
