<Project>

  <!--
    Central Package Management — single source of truth for every NuGet version
    used in this solution. Adding a NEW package: declare it here as
    <PackageVersion …/>, then reference it from a project's csproj WITHOUT a
    Version attribute.

    For docs see https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    ASP.NET Core packages that only ship lib/netN.0 for runtime N (TestHost, OpenIdConnect) follow
    the consuming project's TFM, taking the newest patch of that runtime's servicing line.
    Microsoft.Extensions.* stay on a single 11.x line for both TFMs: Npgsql 11 already requires
    >= 11.0.0 of them on net10.0, so splitting them per TFM would only trigger NU1109 downgrades.
    Bump both values together on every Patch Tuesday.
  -->
  <PropertyGroup>
    <AspNetCorePackageVersion>11.0.0</AspNetCorePackageVersion>
    <AspNetCorePackageVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.15</AspNetCorePackageVersion>
  </PropertyGroup>

  <!--
    Aspire (orchestrator AppHost only). Aspire 17 requires .NET 10+ and replaces
    Aspire.AppHost.Sdk with plain Microsoft.NET.Sdk + Aspire.Hosting.AppHost + Aspire.Hosting.Dotnet.
    17.0.0 clears CVE-2026-118740 / CVE-2026-120006 (fixed in >= 13.6.5).
  -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="17.0.0" />
  </ItemGroup>

  <!--
    Runtime dependencies.

    Newtonsoft.Json is a safety pin, not a dependency of ours: Hangfire.Core pulls in 11.0.1, which
    has a known high-severity ReDoS vulnerability, and CPM with CentralPackageTransitivePinningEnabled=true
    lifts it to 13.0.4 wherever Hangfire.Core is in the graph — FlowOrchestrator.Hangfire (whose
    published package then carries the pinned version) and the projects that reference it.
    No FlowOrchestrator project references Newtonsoft.Json directly any more; since 2.0 Core,
    the storage backends, InMemory, Service Bus, Dashboard and Testing carry no Newtonsoft.Json
    at all. Drop this pin once Hangfire.Core itself depends on a fixed Newtonsoft.Json.
  -->
  <ItemGroup>
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Npgsql" Version="11.0.0" />
  </ItemGroup>

  <!--
    Sample app only: OpenID Connect sign-in against the AppHost's Keycloak container.
    The library itself takes no dependency on it (the dashboard uses whatever scheme the
    host registers). The ASP.NET Core package major must match the sample's TFM.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetCorePackageVersion)" />
  </ItemGroup>

  <!-- Observability — keep all OpenTelemetry packages on the same release line. -->
  <ItemGroup>
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
  </ItemGroup>

  <!-- Test infrastructure -->
  <ItemGroup>
    <!-- TestHost N only ships lib/netN.0, so it follows the test project's TFM. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(AspNetCorePackageVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <!--
      Hangfire job storage on PostgreSQL. No library references it: FlowOrchestrator.Hangfire only
      reads its options by name to warn about a lock timeout longer than the invisibility timeout.
      The Hangfire integration tests pin that diagnostic, and the crash recovery it is about,
      against this exact version.
    -->
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers" Version="4.17.0" />
    <!--
      SSH.NET is pinned (not referenced directly): Testcontainers pulls it in
      transitively, and every version <= 2025.1.0 carries GHSA-q939-rpr3-3284
      (high-severity ScpClient arbitrary-file-write on recursive download).
      CentralPackageTransitivePinningEnabled=true propagates this fixed version
      to the SqlServer / PostgreSQL / ServiceBus integration-test projects.
    -->
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <!-- Build-time only: records each package's public API in PublicAPI.Shipped/Unshipped.txt. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <!-- Build-time only (PrivateAssets=all): embeds an SPDX SBOM in each package. -->
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <!--
      xunit v3, VSTest flavour. `xunit.v3` 4.x pulls in Microsoft Testing Platform v2, which no
      longer runs under `dotnet test` in VSTest mode on the .NET 10+ SDK. CI drives every suite
      through VSTest (`dotnet test <filter>.slnx` plus the "XPlat Code Coverage" collector from
      coverlet.collector), so the test projects reference `xunit.v3.mtp-off` — the same framework,
      assertions and analyzers with MTP switched off — and keep xunit.runner.visualstudio +
      Microsoft.NET.Test.Sdk as the VSTest adapter. Moving to MTP means switching global.json's
      `test.runner` and coverlet.collector to coverlet.MTP in one go.
    -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <!-- Benchmark infrastructure (tests/benchmarks/ only) -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

</Project>
